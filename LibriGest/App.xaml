<Application x:Class="LibriGest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:LibriGest.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="DeepPurple" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters personalizados -->
            <helpers:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <helpers:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
            <helpers:NegativeValueConverter x:Key="NegativeValueConverter"/>
            <helpers:NullToColorConverter x:Key="NullToColorConverter"/>
            <helpers:EstadoCajaColorConverter x:Key="EstadoCajaColorConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
