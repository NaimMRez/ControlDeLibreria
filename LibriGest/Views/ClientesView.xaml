<UserControl x:Class="LibriGest.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Clientes" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="Buscar cliente..."
                    
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0"/>

            <Button Grid.Column="1" Content="NUEVO" Command="{Binding ComandoNuevo}" Margin="4,0"/>
            <Button Grid.Column="2" Content="EDITAR" Command="{Binding ComandoEditar}" Margin="4,0"/>
            <Button Grid.Column="3" Content="ELIMINAR" Command="{Binding ComandoEliminar}" Margin="4,0" Foreground="Red"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="20" Margin="0,0,0,12"
                Visibility="{Binding MostrarFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding EsEdicion, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Editar Cliente;Nuevo Cliente'}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Nombre *" Text="{Binding FormNombre}" Margin="0,4,8,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Documento" Text="{Binding FormDocumento}" Margin="8,4,0,4"/>

                <TextBox Grid.Row="2" Grid.Column="0" materialDesign:HintAssist.Hint="Teléfono" Text="{Binding FormTelefono}" Margin="0,4,8,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail}" Margin="8,4,0,4"/>

                <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" materialDesign:HintAssist.Hint="Dirección" Text="{Binding FormDireccion}" Margin="0,4,0,4"/>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="GUARDAR" Command="{Binding ComandoGuardar}" Margin="4"/>
                    <Button Content="CANCELAR" Command="{Binding ComandoCancelar}" Margin="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Clientes}" SelectedItem="{Binding ClienteSeleccionado}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                 
                  Visibility="{Binding MostrarFormulario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="DOCUMENTO" Binding="{Binding Documento}" Width="120"/>
                <DataGridTextColumn Header="TELÉFONO" Binding="{Binding Telefono}" Width="120"/>
                <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
