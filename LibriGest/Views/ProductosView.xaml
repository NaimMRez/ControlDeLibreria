<UserControl x:Class="LibriGest.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <TextBlock Grid.Row="0" Text="Gestión de Productos" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     materialDesign:HintAssist.Hint="Buscar por nombre o código de barras..."
                     Style="{StaticResource MaterialDesignTextBox}"
                     Text="{Binding Busqueda, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,12,0"/>

            <Button Grid.Column="1" Content="NUEVO" Command="{Binding ComandoNuevo}" Margin="4,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Grid.Column="2" Content="EDITAR" Command="{Binding ComandoEditar}" Margin="4,0" Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button Grid.Column="3" Content="ELIMINAR" Command="{Binding ComandoEliminar}" Margin="4,0" Foreground="Red" Style="{StaticResource MaterialDesignFlatButton}"/>
        </Grid>

        <!-- Formulario (condicional) -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" 
                CornerRadius="8" Padding="24" Margin="0,0,0,12"
                Visibility="{Binding MostrarFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" 
                           Text="{Binding EsEdicion, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Editar Producto;Nuevo Producto'}"
                           FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Código de Barras" Text="{Binding FormCodigoBarras}" Margin="0,4,8,4" Style="{StaticResource MaterialDesignTextBox}"/>
                <TextBox Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Nombre *" Text="{Binding FormNombre}" Margin="8,4,0,4" Style="{StaticResource MaterialDesignTextBox}"/>

                <TextBox Grid.Row="2" Grid.Column="0" materialDesign:HintAssist.Hint="Descripción" Text="{Binding FormDescripcion}" Margin="0,4,8,4" Style="{StaticResource MaterialDesignTextBox}"/>
                
                <ComboBox Grid.Row="2" Grid.Column="1" materialDesign:HintAssist.Hint="Categoría"
                          ItemsSource="{Binding Categorias}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding FormCategoriaId}"
                          Margin="8,4,0,4" Style="{StaticResource MaterialDesignComboBox}"/>

                <ComboBox Grid.Row="3" Grid.Column="0" materialDesign:HintAssist.Hint="Unidad"
                          ItemsSource="{Binding Unidades}" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectedValue="{Binding FormUnidadId}"
                          Margin="0,4,8,4" Style="{StaticResource MaterialDesignComboBox}"/>

                <TextBox Grid.Row="3" Grid.Column="1" materialDesign:HintAssist.Hint="Stock Mínimo" Text="{Binding FormStockMinimo}" Margin="8,4,0,4" Style="{StaticResource MaterialDesignTextBox}"/>

                <TextBox Grid.Row="4" Grid.Column="0" materialDesign:HintAssist.Hint="Precio de Compra" Text="{Binding FormPrecioCompra}" Margin="0,4,8,4" Style="{StaticResource MaterialDesignTextBox}"/>
                <TextBox Grid.Row="4" Grid.Column="1" materialDesign:HintAssist.Hint="Precio de Venta" Text="{Binding FormPrecioVenta}" Margin="8,4,0,4" Style="{StaticResource MaterialDesignTextBox}"/>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="GUARDAR" Command="{Binding ComandoGuardar}" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="CANCELAR" Command="{Binding ComandoCancelar}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Lista de productos -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Productos}" SelectedItem="{Binding ProductoSeleccionado}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  Visibility="{Binding MostrarFormulario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="CÓDIGO" Binding="{Binding CodigoBarras}" Width="120"/>
                <DataGridTextColumn Header="NOMBRE" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="CATEGORÍA" Binding="{Binding Categoria.Nombre}" Width="120"/>
                <DataGridTextColumn Header="P. COMPRA" Binding="{Binding PrecioCompra, StringFormat='{}{0:C}'}" Width="100"/>
                <DataGridTextColumn Header="P. VENTA" Binding="{Binding PrecioVenta, StringFormat='{}{0:C}'}" Width="100"/>
                <DataGridTextColumn Header="STOCK MIN" Binding="{Binding StockMinimo}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
