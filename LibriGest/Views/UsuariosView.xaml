<UserControl x:Class="LibriGest.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Usuarios del Sistema" FontSize="28" FontWeight="Bold" Margin="0,0,0,16" Foreground="{DynamicResource PrimaryHueMidBrush}"/>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Gestión de usuarios y permisos" VerticalAlignment="Center" Opacity="0.7"/>

            <Button Grid.Column="1" Content="NUEVO" Command="{Binding ComandoNuevo}" Margin="4,0" Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button Grid.Column="2" Content="EDITAR" Command="{Binding ComandoEditar}" Margin="4,0" Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button Grid.Column="3" Content="DESACTIVAR" Command="{Binding ComandoEliminar}" Margin="4,0" Foreground="Red" Style="{StaticResource MaterialDesignFlatButton}"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Padding="20" Margin="0,0,0,12"
                Visibility="{Binding MostrarFormulario, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding EsEdicion, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Editar Usuario;Nuevo Usuario'}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

                <TextBox Grid.Row="1" Grid.Column="0" materialDesign:HintAssist.Hint="Usuario *" Text="{Binding FormNombreUsuario}" Margin="0,4,8,4" Style="{StaticResource MaterialDesignTextBox}"/>
                <TextBox Grid.Row="1" Grid.Column="1" materialDesign:HintAssist.Hint="Nombre Completo *" Text="{Binding FormNombreCompleto}" Margin="8,4,0,4" Style="{StaticResource MaterialDesignTextBox}"/>

                <PasswordBox Grid.Row="2" Grid.Column="0" x:Name="PasswordBoxClave" materialDesign:HintAssist.Hint="Contraseña" Margin="0,4,8,4" Style="{StaticResource MaterialDesignPasswordBox}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" materialDesign:HintAssist.Hint="Rol"
                          SelectedItem="{Binding FormRol}" Margin="8,4,0,4" Style="{StaticResource MaterialDesignComboBox}">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Vendedor"/>
                    <ComboBoxItem Content="Almacenero"/>
                </ComboBox>

                <CheckBox Grid.Row="3" Grid.Column="0" Content="Activo" IsChecked="{Binding FormActivo}" Margin="0,8"/>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="GUARDAR" Click="ButtonGuardar_Click" Margin="4" Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="CANCELAR" Command="{Binding ComandoCancelar}" Margin="4" Style="{StaticResource MaterialDesignFlatButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSeleccionado}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  Visibility="{Binding MostrarFormulario, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="USUARIO" Binding="{Binding NombreUsuario}" Width="120"/>
                <DataGridTextColumn Header="NOMBRE" Binding="{Binding NombreCompleto}" Width="*"/>
                <DataGridTextColumn Header="ROL" Binding="{Binding Rol}" Width="120"/>
                <DataGridTextColumn Header="ESTADO" Binding="{Binding Activo}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Activo"/>
                            <Setter Property="Foreground" Value="Green"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Activo}" Value="False">
                                    <Setter Property="Text" Value="Inactivo"/>
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
